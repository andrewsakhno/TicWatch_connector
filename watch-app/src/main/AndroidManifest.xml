<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Lets SensorCollectionService read heart rate when started from the background
         (AutoStartReceiver after reboot/update), not only when started from MainActivity. -->
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.WEARABLE" />

    <!-- Foreground service type for SensorCollectionService, which keeps heart-rate
         collection running for as long as the watch is on, not just while the app is
         in the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Snore detection during sleep (NightBreathingSampleSource): audio is analysed in memory and
         dropped, only a per-epoch snoring fraction leaves the watch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The watch's own GPS track during workouts (WatchRouteRecorder). Workouts start while the app
         is in the background, so the fix stream needs background location, not just while-in-use. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Direct-Bluetooth fallback transport, used when the Wear Data Layer can't reach
         the phone (e.g. no official Wear OS by Google pairing). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Required to install the APK bytes pushed over the channel via PackageInstaller.
         On a non-system app this still surfaces the standard Android "install unknown
         apps" confirmation on the watch; it does not enable silent installs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Install-confirmation prompt (InstallConfirmationPrompt) when a direct activity launch is blocked. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Exempts the install-confirmation launch from background-activity-start limits. Wear has
         no settings UI for it: grant via `adb shell appops set org.sand.ticwatch.watch SYSTEM_ALERT_WINDOW allow`. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Debug capability probe only: lists vendor (Mobvoi) packages' content providers. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Keeps the CPU up during the periodic vendor-sensor measurement window. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mobvoi's own health/fitness data; granted only if Mobvoi declared them non-signature. On other
         watches the permissions don't exist: Android ignores the request, nothing checks or requests them
         at runtime (VendorDataProbe only reports their state), so the app installs and runs unaffected. -->
    <uses-permission android:name="com.mobvoi.wear.permission.HEALTH_DATA_NORMAL" />
    <uses-permission android:name="com.mobvoi.ticwear.permission.HEALTH" />
    <uses-permission android:name="com.mobvoi.ticwear.permission.FITNESS_DATA" />
    <!-- TicWatchFaceService: lets the face run as the always-visible wallpaper. -->
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />

    <application
        android:name=".WatchApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TicWatchConnectorWatch">

        <uses-library android:name="com.google.android.wearable" android:required="false" />
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- No screenOrientation: "nosensor" overrode the user's 180° wrist flip while in front. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps heart-rate collection (and the bridge sync to the phone) running for
             as long as the watch is powered on, independent of MainActivity's lifecycle. -->
        <service
            android:name=".sensors.SensorCollectionService"
            android:exported="false"
            android:foregroundServiceType="health|microphone" />

        <!-- Receives install/uninstall requests and APK bytes pushed down from phone-app. -->
        <service
            android:name=".datalayer.WatchDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

        <!-- Accepts direct-Bluetooth connections from the phone's BluetoothClassicTransport
             fallback, when the Wear Data Layer path isn't usable. -->
        <service
            android:name=".transport.BluetoothLinkServerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Watch face with live heart rate and ambient temperature from SensorCollectionService. -->
        <service
            android:name=".watchface.TicWatchFaceService"
            android:directBootAware="false"
            android:exported="true"
            android:label="@string/watch_face_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/watch_face_preview" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview_circular"
                android:resource="@drawable/watch_face_preview" />
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
        </service>

        <!-- Tile with live heart rate and ambient temperature, read from SensorCollectionService. -->
        <service
            android:name=".tile.TicWatchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_heart"
            android:label="@string/tile_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Restarts the long-running services after reboot / app update. -->
        <receiver
            android:name=".AutoStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
