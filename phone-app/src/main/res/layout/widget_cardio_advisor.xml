<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advisor_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/advisor_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/advisor_widget_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/advisor_widget_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/advisor_widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/advisor_widget_loading"
            android:textColor="@color/advisor_widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/advisor_widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/advisor_widget_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/advisor_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/advisor_widget_pressure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/advisor_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/advisor_widget_vitals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/advisor_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/advisor_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="@color/advisor_widget_secondary_text"
        android:textSize="11sp" />
</LinearLayout>
